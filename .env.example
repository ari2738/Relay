# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/relay

# --- Better Auth -------------------------------------------------------------
# Generate a random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (optional — Credentials login works without these) --------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Priority 2: image uploads (either one) ----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# or
UPLOADTHING_TOKEN=

# --- Priority 7: AI features --------------------------------------------------
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-haiku-4-5-20251001 in lib/ai.ts
ANTHROPIC_MODEL=
